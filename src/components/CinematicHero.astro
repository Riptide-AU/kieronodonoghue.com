---
import { getImage } from 'astro:assets';
import sailingImg from '../assets/images/sailing.png';
import vulcanImg from '../assets/images/vulcan.png';
import { SITE, SOCIAL, CONTACT_EMAIL } from '../consts';

/*
  Full-bleed cinematic hero. Two scenes (sailing sunset + Vulcan) cross-fade on
  a timer. Each scene is a <video> that falls back to an optimised poster image
  until the real clip is supplied at the paths below — so the hero looks
  finished today and simply "wakes up" once the videos are dropped in:

    public/media/hero-sailing.mp4
    public/media/hero-vulcan.mp4

  Motion (drift + cross-fade + autoplay) is fully disabled under
  prefers-reduced-motion; a single still scene is shown instead.
*/

const sailingPoster = await getImage({
  src: sailingImg,
  format: 'webp',
  width: 1920,
});
const vulcanPoster = await getImage({
  src: vulcanImg,
  format: 'webp',
  width: 1920,
});

const scenes = [
  { src: '/media/hero-sailing.mp4', poster: sailingPoster.src, label: 'Sailing at sunset' },
  { src: '/media/hero-vulcan.mp4', poster: vulcanPoster.src, label: 'Kawasaki Vulcan S' },
];
---

<section
  class="relative isolate flex min-h-[88vh] flex-col justify-end overflow-hidden"
  aria-label="Introduction"
>
  <!-- MEDIA STACK -->
  <div class="absolute inset-0 z-0" data-hero-media aria-hidden="true">
    {
      scenes.map((scene, i) => (
        <div class="hero-scene" data-hero-scene data-active={i === 0 ? '' : undefined}>
          <video
            data-hero-video
            muted
            loop
            playsinline
            preload={i === 0 ? 'auto' : 'metadata'}
            poster={scene.poster}
          >
            <source src={scene.src} type="video/mp4" />
          </video>
        </div>
      ))
    }
    <!-- Scrim: dark from bottom-left so the copy stays legible over any frame. -->
    <div
      class="absolute inset-0"
      style="background:
        linear-gradient(to top, rgba(11,17,29,0.96) 0%, rgba(11,17,29,0.55) 38%, rgba(11,17,29,0.15) 70%, rgba(11,17,29,0.35) 100%),
        linear-gradient(to right, rgba(11,17,29,0.75) 0%, rgba(11,17,29,0.15) 55%, transparent 100%);"
    >
    </div>
    <!-- Fine data-grid overlay ties the cinematic media back to the brand. -->
    <div
      class="absolute inset-0 opacity-40"
      style="background-image:
        linear-gradient(to right, rgba(92,192,171,0.06) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(92,192,171,0.06) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse at 30% 100%, black, transparent 70%);"
    >
    </div>
  </div>

  <!-- CONTENT -->
  <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pb-16 pt-32 md:pb-24 md:pt-40">
    <p class="eyebrow">
      {SITE.jobTitle} · Business Analytics · B.Com (Accounting)
    </p>

    <h1
      class="font-display mt-5 text-5xl font-bold leading-[1.02] tracking-tight text-ink sm:text-6xl md:text-7xl"
    >
      {SITE.name}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl">
      I work at the intersection of business, technology, analytics, and
      accounting — building practical systems and writing about what I'm
      learning. Off the clock, that curiosity runs to motorcycles, boats, and
      whatever I'm building next.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a
        href="/projects/"
        class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-[#06231f] shadow-md transition-all hover:bg-accent-strong hover:shadow-glow"
      >
        See my work
      </a>
      <a
        href="/writing/"
        class="rounded-lg border border-border-strong bg-surface/40 px-5 py-2.5 text-sm font-semibold text-ink backdrop-blur transition-colors hover:border-accent/60 hover:text-accent"
      >
        Read my writing
      </a>
      <a
        href={SOCIAL.linkedin}
        target="_blank"
        rel="me noopener noreferrer"
        class="ml-1 text-sm text-muted transition-colors hover:text-ink"
      >
        LinkedIn
      </a>
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="text-sm text-muted transition-colors hover:text-ink"
      >
        Email
      </a>
    </div>

    <!-- Scene switcher -->
    <div class="mt-12 flex items-center gap-3" data-hero-dots>
      {
        scenes.map((scene, i) => (
          <button
            type="button"
            data-hero-dot
            data-index={i}
            aria-label={`Show scene: ${scene.label}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="group flex items-center gap-2 text-xs text-muted transition-colors hover:text-ink"
          >
            <span
              class="h-1.5 w-8 rounded-full bg-border transition-all group-hover:bg-muted"
              data-hero-dot-bar
            />
            <span class="hidden sm:inline">{scene.label}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root) return;
    const scenes = Array.from(root.querySelectorAll('[data-hero-scene]'));
    const videos = Array.from(root.querySelectorAll('[data-hero-video]'));
    const dots = Array.from(root.querySelectorAll('[data-hero-dot]'));
    if (!scenes.length) return;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer = 0;
    const HOLD = 7000; // ms each scene is shown

    function activeBar(i) {
      dots.forEach((d, di) => {
        const bar = d.querySelector('[data-hero-dot-bar]');
        d.setAttribute('aria-pressed', di === i ? 'true' : 'false');
        if (bar) {
          bar.style.background = di === i ? 'var(--color-accent)' : '';
          bar.style.width = di === i ? '2.75rem' : '';
        }
      });
    }

    function show(i) {
      current = (i + scenes.length) % scenes.length;
      scenes.forEach((s, si) => {
        const on = si === current;
        if (on) s.setAttribute('data-active', '');
        else s.removeAttribute('data-active');
        const v = videos[si];
        if (v) {
          if (on && !reduce.matches) {
            const p = v.play();
            if (p && p.catch) p.catch(() => {});
          } else {
            v.pause();
          }
        }
      });
      activeBar(current);
    }

    function schedule() {
      clearTimeout(timer);
      if (reduce.matches || scenes.length < 2) return;
      timer = window.setTimeout(() => show(current + 1), HOLD);
    }

    function go(i) {
      show(i);
      schedule();
    }

    dots.forEach((d) =>
      d.addEventListener('click', () => go(Number(d.dataset.index) || 0)),
    );

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearTimeout(timer);
        videos.forEach((v) => v.pause());
      } else {
        go(current);
      }
    });

    reduce.addEventListener('change', () => go(current));

    // Kick things off.
    show(0);
    schedule();
  })();
</script>
