---
import { NAV, SITE } from '../consts';

// Normalise the current path for active-link matching (trailing slash tolerant).
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') return here === '/';
  return here === target || here.startsWith(target + '/');
};
---

<!--
  Site header: name on the left, five nav links on the right.
  On narrow screens the links wrap onto their own row, so there is no menu
  button and no JavaScript.
-->
<header
  class="wrap flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 py-6"
>
  <a
    href="/"
    class="font-display text-[0.9375rem] font-semibold text-ink transition-colors hover:text-accent"
  >
    {SITE.name}
  </a>

  <nav aria-label="Primary">
    <ul class="flex flex-wrap gap-x-6 text-[0.9375rem]">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block border-b py-2 transition-colors',
                isActive(item.href)
                  ? 'border-accent text-ink'
                  : 'border-transparent text-muted hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
