---
import { SITE, SOCIAL_LINKS, RIPTIDE } from '../consts';

const year = new Date().getFullYear();
---

<!--
  Site footer: full name, social links, email and Riptide Digital.
  Riptide Digital shows as "coming soon" until RIPTIDE.live is set to true
  in src/consts.ts.
-->
<footer class="wrap mt-24">
  <div class="grid gap-6 border-t border-border pt-12 pb-16">
    <p class="font-display text-2xl font-semibold text-ink">{SITE.name}</p>

    <ul class="flex flex-wrap items-center gap-x-6 text-[0.9375rem]">
      {
        SOCIAL_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="block py-2 text-ink-soft transition-colors hover:text-accent"
              {...(link.href.startsWith('http')
                ? { target: '_blank', rel: 'me noopener noreferrer' }
                : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        {
          RIPTIDE.live ? (
            <a
              href={RIPTIDE.aboutUrl}
              rel="me"
              class="block py-2 text-ink-soft transition-colors hover:text-accent"
            >
              {RIPTIDE.name}
            </a>
          ) : (
            <span class="block py-2 text-sm text-muted">
              {RIPTIDE.name} (coming soon)
            </span>
          )
        }
      </li>
    </ul>

    <p class="text-[0.8125rem] text-muted">&copy; {year} {SITE.name}</p>
  </div>
</footer>
