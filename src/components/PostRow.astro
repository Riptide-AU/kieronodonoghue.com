---
/*
  One row in a list of writing: date, title with a short description, and
  the category. Use inside <ul class="ledger">. The whole row is clickable.
*/
interface Props {
  title: string;
  href: string;
  description?: string;
  date: Date;
  category?: string;
}

const { title, href, description, date, category } = Astro.props;

const dateLabel = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(date);
---

<li class="post">
  <time class="meta" datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
  <div>
    <h3><a href={href}>{title}</a></h3>
    {description && <p>{description}</p>}
  </div>
  {category && <span class="meta">{category}</span>}
</li>

<style>
  .post {
    position: relative;
    transition: background-color 0.2s;
  }
  .post:hover {
    background: var(--color-surface);
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* Stretch the link over the whole row */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post:hover h3 a {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  p {
    max-width: 60ch;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }
  @media (min-width: 52rem) {
    .post {
      grid-template-columns: 8rem minmax(0, 1fr) auto;
      align-items: baseline;
      padding-inline: 0.75rem;
      margin-inline: -0.75rem;
    }
  }
</style>
