---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';

// Everything in one list, newest first. Ideas are posts with the
// category "Ideas".
const posts = (await getCollection('writing', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Writing"
  description="Articles, notes and ideas by Kieron O’Donoghue on business, analytics, technology, AI, app building and what he is learning."
>
  <section class="page-head wrap">
    <h1 class="page-title">Writing</h1>
    <p class="lede">
      Articles, notes and ideas. Some are finished thoughts. Others are written
      while I’m still in the middle of working something out.
    </p>
  </section>

  <section class="section wrap">
    {
      posts.length > 0 ? (
        <ul class="ledger">
          {posts.map((post) => (
            <PostRow
              title={post.data.title}
              href={`/writing/${post.id}/`}
              description={post.data.description}
              date={post.data.pubDate}
              category={post.data.category}
            />
          ))}
        </ul>
      ) : (
        <p class="meta">Writing coming soon.</p>
      )
    }
  </section>
</BaseLayout>
