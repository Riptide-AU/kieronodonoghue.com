---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureImage from '../../components/FeatureImage.astro';
import { SITE } from '../../consts';

export const getStaticPaths = (async () => {
  const posts = await getCollection('writing', (p) => !p.data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(d);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedDate={entry.data.pubDate}
  modifiedDate={entry.data.updatedDate}
  image={entry.data.heroImage?.src}
>
  <article class="wrap post">
    <header class="page-head">
      <a href="/writing/" class="back-link">Back to Writing</a>
      <h1 class="page-title">{entry.data.title}</h1>
      <p class="meta post__meta">
        <time datetime={entry.data.pubDate.toISOString().slice(0, 10)}>
          {fmt(entry.data.pubDate)}
        </time>
        {entry.data.category && <span>{entry.data.category}</span>}
        {
          entry.data.updatedDate && (
            <span>Updated {fmt(entry.data.updatedDate)}</span>
          )
        }
      </p>
    </header>

    {
      entry.data.heroImage && (
        <div class="post__image">
          <FeatureImage
            src={entry.data.heroImage}
            alt={entry.data.heroImageAlt ?? entry.data.title}
            loading="eager"
            sizes="(min-width: 768px) 44rem, 100vw"
          />
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <p class="meta post__byline">By {SITE.name}</p>
  </article>
</BaseLayout>

<style>
  /* One reading column, lined up with the left edge of the page */
  .post .page-title {
    max-width: 20ch;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.05;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
  }
  .post__image,
  .prose {
    max-width: 44rem;
  }
  .post__image {
    margin-bottom: 2rem;
  }
  .post__byline {
    margin-top: 3rem;
    padding-top: 1rem;
    max-width: 44rem;
    border-top: 1px solid var(--color-border);
  }
</style>
