---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex={true}>
  <section class="page-head wrap">
    <h1 class="page-title">Page not found</h1>
    <p class="lede">
      The page you’re looking for doesn’t exist or may have moved.
    </p>
    <p class="actions">
      <a href="/" class="btn-accent">Go to the home page</a>
      <a href="/writing/" class="link-more">Read my writing</a>
    </p>
  </section>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 3rem;
  }
</style>
