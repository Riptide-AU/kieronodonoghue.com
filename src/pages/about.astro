---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import vulcan from '../assets/images/vulcan.png';
import sailing from '../assets/images/sailing.png';
import { SOCIAL_LINKS, RIPTIDE } from '../consts';

// Small lists of content keep the page below readable and easy to edit.

// The quick-facts panel at the top of the page.
const atAGlance = [
  { label: 'Role', value: 'Business Analyst' },
  { label: 'Field', value: 'Data & Finance Infrastructure' },
  { label: 'Based in', value: 'Australia' },
  { label: 'Education', value: 'B.Business Analytics' },
  { label: 'Studying', value: 'B.Commerce (Accounting)' },
];

const background = [
  {
    title: 'Business analytics',
    body: 'I hold a Bachelor of Business Analytics. It is the foundation for how I read and work with data.',
  },
  {
    title: 'Business analyst work',
    body: 'Years of hands-on work with business systems, reporting, data cleansing and process improvement, in industries including construction, wholesale and health.',
  },
  {
    title: 'Accounting',
    body: 'I am studying a Bachelor of Commerce (Accounting) to deepen the commercial side: the systems and rules behind the numbers.',
  },
  {
    title: 'Building in public',
    body: 'I started Riptide Digital to build my own apps, and I write here about what I learn along the way.',
  },
];

// How I approach a piece of work, in order.
const approach = [
  {
    title: 'Understand it first',
    body: 'I map how a process actually works before changing anything. Most of the value is in understanding it properly.',
  },
  {
    title: 'Simplify, then automate',
    body: 'A messy process automated is just a faster mess. I simplify first, then automate what remains.',
  },
  {
    title: 'Build in checks',
    body: 'I add simple validation so a workflow flags obvious problems instead of passing them through silently.',
  },
  {
    title: 'Keep it maintainable',
    body: 'I favour solutions that someone else, or future me, can still understand and trust later.',
  },
];

const learning = [
  { title: 'Flutter', body: 'Building apps for Android and iPhone' },
  { title: 'Python', body: 'Automation and analysis' },
  { title: 'SQL', body: 'Querying and shaping data' },
  { title: 'JavaScript', body: 'Web application work' },
  { title: 'CSS', body: 'Layout and interface' },
];

const interests = [
  'Business analytics',
  'Process improvement',
  'Automation',
  'Accounting and commercial systems',
  'AI',
  'App and web development',
  'Writing fiction',
  'Game design',
  'Boats, motorcycles and practical DIY',
];

// Short descriptions for the links at the bottom of the page.
const linkNotes: Record<string, string> = {
  LinkedIn: 'Professional profile and work history.',
  Facebook: 'Personal profile.',
  GitHub: 'Code, projects and experiments.',
  Amazon: 'My books, including the Soul War Saga.',
  Goodreads: 'My books, reviews and reading.',
  Email: 'The best way to get in touch directly.',
};
---

<BaseLayout
  title="About"
  description="About Kieron O’Donoghue: a business analyst who builds apps, tools and systems, runs Riptide Digital, and writes fiction."
>
  <!-- INTRO -->
  <section class="page-head wrap intro">
    <div>
      <h1 class="page-title">I’m Kieron O’Donoghue.</h1>
      <p class="lede">
        I’m a business analyst who builds things: apps, tools and systems that
        solve practical problems. I run Riptide Digital, where I’m building
        PainTrail, a pain diary app. I also write fiction.
      </p>
    </div>

    <dl class="glance">
      {
        atAGlance.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- WHO I AM -->
  <section class="section wrap split">
    <h2 class="section-title">Who I am</h2>
    <div class="text">
      <p>
        I’m a practical, curious, analytical person. I’m more interested in
        building systems that work than in talking about them, and I’d rather
        be honest about what I’m still learning than overstate what I know.
      </p>
      <p>
        Most of what I do comes back to the same instinct: take something messy
        or repetitive, understand it properly, and make it simpler and more
        reliable.
      </p>
    </div>
  </section>

  <!-- WHAT I'M BUILDING -->
  <section class="section wrap split">
    <h2 class="section-title">What I’m building</h2>
    <div class="text">
      <p>
        My main project is <a href="/building/paintrail/">PainTrail</a>, a pain
        diary app that is quick to fill in, works offline and keeps your
        entries on your own phone. It is the first app from
        <a href={RIPTIDE.url}>{RIPTIDE.name}</a>, my independent app studio.
      </p>
      <p>
        <a class="link-more" href="/building/">See everything I’m building</a>
      </p>
    </div>
  </section>

  <!-- BACKGROUND -->
  <section class="section wrap">
    <h2 class="section-title">Background</h2>
    <ul class="ledger">
      {
        background.map((item) => (
          <li class="pair">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- HOW I WORK -->
  <section class="section wrap">
    <h2 class="section-title">How I work</h2>
    <ol class="ledger">
      {
        approach.map((item) => (
          <li class="pair">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- LEARNING AND INTERESTS -->
  <section class="section wrap">
    <h2 class="section-title">What I’m learning</h2>
    <p class="meta note">
      I’m developing these through real projects: learning as I build, not
      claiming to be an expert.
    </p>
    <ul class="ledger">
      {
        learning.map((item) => (
          <li class="pair">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap split">
    <h2 class="section-title">Interests</h2>
    <p class="text">{interests.join(' · ')}</p>
  </section>

  <!-- BEYOND WORK -->
  <section class="section wrap">
    <h2 class="section-title">Beyond work</h2>
    <div class="beyond">
      <article>
        <Image
          src={vulcan}
          alt="Stylised artwork of a motorcycle"
          widths={[320, 640, 960]}
          sizes="(min-width: 832px) 24rem, 100vw"
          loading="lazy"
        />
        <h3>Motorcycles</h3>
        <p>
          I enjoy riding and tinkering with motorcycles: practical, mechanical,
          and a good reason to work with my hands.
        </p>
      </article>
      <article>
        <Image
          src={sailing}
          alt="Stylised artwork of a sailing boat on the water"
          widths={[320, 640, 960]}
          sizes="(min-width: 832px) 24rem, 100vw"
          loading="lazy"
        />
        <h3>Sailing and boats</h3>
        <p>
          Time on the water is my reset. Boats are another kind of system to
          understand, maintain and get right.
        </p>
      </article>
      <article>
        <a class="beyond__riptide" href={RIPTIDE.url}>
          <span>{RIPTIDE.name}</span>
        </a>
        <h3>{RIPTIDE.name}</h3>
        <p>
          My app studio, where I build small, private, useful apps. PainTrail
          is the first.
        </p>
        <p>
          <a class="link-more" href={RIPTIDE.url}>riptidedigital.com.au</a>
        </p>
      </article>
    </div>
  </section>

  <!-- A PRINCIPLE -->
  <section class="section wrap">
    <blockquote>
      <p>
        “Understand the process before you try to improve it. Automating a messy
        routine just produces a faster mess.”
      </p>
      <footer class="meta">A principle that shapes most of how I work.</footer>
    </blockquote>
  </section>

  <!-- FIND ME (this section replaces the old Links page in the nav) -->
  <section class="section wrap" id="links">
    <h2 class="section-title">Find me</h2>
    <ul class="ledger">
      <li class="pair pair--link">
        <h3><a href={RIPTIDE.url}>{RIPTIDE.name}</a></h3>
        <p>My app studio.</p>
      </li>
      {
        SOCIAL_LINKS.map((link) => (
          <li class="pair pair--link">
            <h3>
              <a
                href={link.href}
                {...(link.href.startsWith('http')
                  ? { target: '_blank', rel: 'me noopener noreferrer' }
                  : {})}
              >
                {link.label}
              </a>
            </h3>
            <p>{linkNotes[link.label] ?? ''}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* Intro: text on the left, quick facts on the right */
  .intro {
    display: grid;
    gap: 3rem;
  }
  .glance {
    align-self: end;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }
  .glance div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .glance dt {
    color: var(--color-muted);
  }
  .glance dd {
    color: var(--color-ink);
    font-weight: 500;
    text-align: right;
  }

  /* Heading on the left, reading text on the right */
  .split {
    display: grid;
    gap: 1.5rem 2rem;
  }
  .text {
    max-width: 60ch;
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .text p + p {
    margin-top: 1rem;
  }
  .text a:not(.link-more) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .note {
    max-width: 60ch;
    margin-block: 1rem 2rem;
  }

  /* Ledger rows with a title and a line of text */
  .pair h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .pair p {
    max-width: 60ch;
  }
  .pair--link {
    position: relative;
    transition: background-color 0.2s;
  }
  .pair--link:hover {
    background: var(--color-surface);
  }
  .pair--link a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pair--link:hover a {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  /* Beyond work: three columns, no boxes */
  .beyond {
    display: grid;
    gap: 3rem 2rem;
    margin-top: 2rem;
  }
  .beyond :global(img),
  .beyond__riptide {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 2px;
  }
  .beyond__riptide {
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: border-color 0.2s;
  }
  .beyond__riptide:hover {
    border-color: var(--color-accent);
  }
  .beyond h3 {
    margin-top: 1.25rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .beyond p {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }

  blockquote {
    max-width: 30ch;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: clamp(1.5rem, 2.5vw + 0.75rem, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  blockquote footer {
    margin-top: 1.5rem;
    font-family: var(--font-sans);
    font-stretch: 100%;
    font-weight: 400;
    letter-spacing: 0;
  }

  @media (min-width: 52rem) {
    .intro {
      grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 1fr);
    }
    .split,
    .pair {
      grid-template-columns: minmax(0, 5fr) minmax(0, 10fr);
      align-items: baseline;
    }
    .pair--link {
      padding-inline: 0.75rem;
      margin-inline: -0.75rem;
    }
    .beyond {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
