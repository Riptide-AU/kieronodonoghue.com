---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroReveal from '../components/HeroReveal.astro';
import PlaceholderCover from '../components/PlaceholderCover.astro';
import PostRow from '../components/PostRow.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { SITE, NOW, RIPTIDE } from '../consts';

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('en-AU', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(d);

// "Now building": projects marked both `current` and `featured`, newest first.
const building = (
  await getCollection(
    'projects',
    (p) => !p.data.draft && p.data.current && p.data.featured,
  )
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// The three most recent posts. Drafts are excluded.
const writing = (await getCollection('writing', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// The whole series, in reading order.
const books = (await getCollection('books', (b) => !b.data.draft)).sort(
  (a, b) => (a.data.bookNumber ?? 0) - (b.data.bookNumber ?? 0),
);
const bookStatus = (status: string) =>
  status === 'Published' ? 'Out now' : status;
---

<BaseLayout
  titleOverride={`${SITE.name}: a business analyst who builds things`}
  description={SITE.description}
>
  <!-- HERO -->
  <section class="hero wrap" aria-label="Introduction">
    <HeroReveal class="hero__portrait" />

    <div class="hero__text">
      <h1>Kieron<br />O’Donoghue</h1>

      <p class="hero__lede">
        I’m a business analyst who builds things: apps, tools and systems that
        solve practical problems.
      </p>

      <div class="hero__actions">
        <a class="btn-accent" href="/building/">
          What I’m building
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"></path>
          </svg>
        </a>
        {
          RIPTIDE.live ? (
            <a class="link-more hero__riptide" href={RIPTIDE.url}>
              {RIPTIDE.name}
            </a>
          ) : (
            <span class="hero__riptide">
              {RIPTIDE.name}
              <span class="hero__soon">site coming soon</span>
            </span>
          )
        }
      </div>
    </div>

    <p class="hero__now">
      <span class="hero__now-label">Now</span>
      <time datetime={NOW.date}>{formatDate(new Date(NOW.date))}</time>
      <span>{NOW.text}</span>
    </p>
  </section>

  <!-- NOW BUILDING -->
  <section class="section wrap">
    <div class="section-head">
      <h2 class="section-title">Now building</h2>
      <a class="link-more" href="/building/">Everything I’m building</a>
    </div>
    <ul class="ledger">
      {
        building.map((p) => (
          <ProjectRow
            title={p.data.title}
            href={`/building/${p.id}/`}
            description={p.data.description}
            status={p.data.status}
            active
          />
        ))
      }
    </ul>
  </section>

  <!-- RECENT WRITING -->
  {
    writing.length > 0 && (
      <section class="section wrap">
        <div class="section-head">
          <h2 class="section-title">Recent writing</h2>
          <a class="link-more" href="/writing/">
            All writing
          </a>
        </div>
        <ul class="ledger">
          {writing.map((post) => (
            <PostRow
              title={post.data.title}
              href={`/writing/${post.id}/`}
              description={post.data.description}
              date={post.data.pubDate}
              category={post.data.category}
            />
          ))}
        </ul>
      </section>
    )
  }

  <!-- BOOKS -->
  <section class="section wrap books">
    <div>
      <h2 class="section-title">Books</h2>
      <p class="books__text">
        I also write fiction. The Soul War Saga is a fantasy series, and book
        one, <em>Emergence</em>, is out now.
      </p>
      <a class="link-more" href="/books/">About the series</a>
    </div>
    <ul class="shelf">
      {
        books.map((book) => (
          <li>
            <a href={`/books/${book.id}/`}>
              {book.data.coverImage ? (
                <Image
                  src={book.data.coverImage}
                  alt={book.data.coverImageAlt ?? book.data.title}
                  widths={[160, 320]}
                  sizes="9rem"
                  loading="lazy"
                />
              ) : (
                <PlaceholderCover
                  title={book.data.title}
                  seriesText={`Book ${book.data.bookNumber}`}
                  variant={book.data.placeholderCover ?? 'steel'}
                />
              )}
              <span class="shelf__title">{book.data.title}</span>
            </a>
            <span class="shelf__status">{bookStatus(book.data.status)}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  /* Phones: the portrait sits at the top and the text overlaps its lower
     part. Wider screens (see the bottom of this file): text on the left,
     portrait on the right. */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: 0 4.5rem;
  }
  .hero :global(.hero__portrait) {
    z-index: -1;
    margin-inline: calc(clamp(1.25rem, 4vw, 3rem) * -1);
  }
  .hero__text {
    margin-top: -22%;
  }
  h1 {
    font-size: clamp(2.6rem, 11vw, 5.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .hero__lede {
    max-width: 34ch;
    margin-top: 2rem;
    color: var(--color-ink);
    font-size: clamp(1.1875rem, 1.6vw + 0.8rem, 1.5rem);
    line-height: 1.4;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 3rem;
  }
  .hero__riptide {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--color-ink);
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .hero__soon {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 400;
  }
  .hero__now {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 4.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }
  .hero__now-label {
    color: var(--color-accent);
    font-weight: 600;
  }
  .hero__now time {
    color: var(--color-muted);
  }

  /* ---------- Books ---------- */
  .books {
    display: grid;
    gap: 3rem;
  }
  .books__text {
    max-width: 38ch;
    margin-block: 1rem 1.5rem;
  }
  .shelf {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 9rem));
    gap: 1.5rem;
  }
  /* :global() because the covers are drawn by other components */
  .shelf :global(img),
  .shelf :global(.ph) {
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 14px 28px -12px rgba(0, 0, 0, 0.9);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .shelf a:hover :global(img),
  .shelf a:hover :global(.ph) {
    transform: translateY(-4px);
  }
  .shelf__title {
    display: block;
    margin-top: 1rem;
    color: var(--color-ink);
    font-weight: 600;
  }
  .shelf__status {
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  @media (min-width: 52rem) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      align-items: center;
      column-gap: 1rem;
      padding-top: 1.5rem;
    }
    .hero :global(.hero__portrait) {
      grid-column: 2;
      grid-row: 1;
      margin-inline: 0;
    }
    .hero__text {
      grid-column: 1;
      grid-row: 1;
      margin-top: 0;
    }
    /* The name may run a little over the portrait's faded left edge */
    h1 {
      white-space: nowrap;
    }
    .hero__now {
      grid-column: 1 / -1;
      margin-top: 2rem;
    }
    .books {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
</style>
