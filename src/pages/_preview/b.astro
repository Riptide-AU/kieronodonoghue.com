---
/*
  DESIGN PREVIEW B: "Title page"
  A static mock-up of the home page for comparing design directions.
  It is self-contained on purpose: its own tokens, fonts and styles, so it
  doesn't touch global.css or the live layout.

  Astro skips folders that start with "_", so this page is never built or
  deployed. astro.config.mjs makes it viewable in `npm run dev` only, at
  /_preview/b
*/
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PlaceholderCover from '../../components/PlaceholderCover.astro';
import { SITE, SOCIAL, CONTACT_EMAIL } from '../../consts';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk';

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('en-AU', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(d);

const writing = (await getCollection('writing', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const books = (await getCollection('books', (b) => !b.data.draft)).sort(
  (a, b) => (a.data.bookNumber ?? 0) - (b.data.bookNumber ?? 0),
);

const bookStatus = (status: string) =>
  status === 'Published' ? 'Out now' : status;

// Draft copy for the preview only. The real page will read these from consts.
const now = {
  date: '13 Nov 2026',
  text: 'Building PainTrail and setting up Riptide Digital.',
};

const nav = [
  { label: 'Home', href: '/_preview/b' },
  { label: 'Building', href: '#building' },
  { label: 'Writing', href: '#writing' },
  { label: 'Books', href: '#books' },
  { label: 'About', href: '/about/' },
];

const links = [
  { label: 'LinkedIn', href: SOCIAL.linkedin },
  { label: 'GitHub', href: SOCIAL.github },
  { label: 'Facebook', href: SOCIAL.facebook },
  { label: 'Amazon', href: SOCIAL.amazon },
  { label: 'Goodreads', href: SOCIAL.goodreads },
  { label: 'Email', href: `mailto:${CONTACT_EMAIL}` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Preview B: Title page · {SITE.name}</title>
  </head>
  <body class="pv-b">
    <a href="#main" class="skip">Skip to content</a>

    <p class="pv-note">
      Design preview B, “Title page”. Not a live page.
      <a href="/_preview/a">Compare with A</a>
    </p>

    <header class="top wrap">
      <a href="/_preview/b" class="top__name">{SITE.name}</a>
      <nav aria-label="Primary">
        <ul class="top__nav">
          {
            nav.map((item, i) => (
              <li>
                <a href={item.href} aria-current={i === 0 ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <!-- HERO -->
      <section class="hero wrap" aria-label="Introduction">
        <!-- The green apostrophe is the one decorative use of the accent. -->
        <h1>Kieron O<span class="apos">’</span>Donoghue</h1>

        <div class="row">
          <p class="side hero__now">
            <span class="hero__now-label">Now, <time>{now.date}</time></span>
            {now.text}
          </p>
          <div>
            <p class="hero__lede">
              I’m a business analyst who builds things: apps, tools and
              systems that solve practical problems. I run Riptide Digital,
              where I’m building PainTrail, a pain diary app. I also write
              fiction.
            </p>
            <div class="hero__actions">
              <a class="link" href="#building">What I’m building</a>
              <span class="soon">
                Riptide Digital
                <span class="soon__tag">site coming soon</span>
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- NOW BUILDING -->
      <section id="building" class="block wrap row">
        <h2 class="side">Now building</h2>
        <ul class="stack">
          <li>
            <h3>PainTrail</h3>
            <p class="status">
              <span class="dot" aria-hidden="true"></span>
              In development, Android first
            </p>
            <p>
              A pain diary app. Quick to fill in, works offline, and keeps
              your entries on your own phone.
            </p>
          </li>
          <li>
            <h3>Riptide Digital</h3>
            <p class="status">Website coming soon</p>
            <p>My independent app studio. PainTrail is its first app.</p>
          </li>
        </ul>
      </section>

      <!-- RECENT WRITING -->
      <section id="writing" class="block wrap row">
        <h2 class="side">Recent writing</h2>
        <div>
          <ul class="stack">
            {
              writing.map((post) => (
                <li>
                  <h3>
                    <a href={`/writing/${post.id}/`}>{post.data.title}</a>
                  </h3>
                  <p class="status">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                    {post.data.category && <span>{post.data.category}</span>}
                  </p>
                  <p>{post.data.description}</p>
                </li>
              ))
            }
          </ul>
          <a class="link more" href="/writing/">All writing</a>
        </div>
      </section>

      <!-- BOOKS -->
      <section id="books" class="block wrap row">
        <h2 class="side">Books</h2>
        <div>
          <p class="books__text">
            I also write fiction. The Soul War Saga is a fantasy series, and
            book one, <em>Emergence</em>, is out now.
          </p>
          <ul class="shelf">
            {
              books.map((book) => (
                <li>
                  <a href={`/books/${book.id}/`}>
                    {book.data.coverImage ? (
                      <Image
                        src={book.data.coverImage}
                        alt={book.data.coverImageAlt ?? book.data.title}
                        widths={[200, 400]}
                        sizes="12rem"
                        loading="lazy"
                      />
                    ) : (
                      <PlaceholderCover
                        title={book.data.title}
                        seriesText={`Book ${book.data.bookNumber}`}
                        variant={book.data.placeholderCover ?? 'steel'}
                      />
                    )}
                    <span class="shelf__title">{book.data.title}</span>
                  </a>
                  <span class="status">{bookStatus(book.data.status)}</span>
                </li>
              ))
            }
          </ul>
          <a class="link more" href="/books/">About the series</a>
        </div>
      </section>
    </main>

    <footer class="foot wrap row">
      <p class="side foot__legal">© 2026</p>
      <div>
        <p class="foot__name">{SITE.name}</p>
        <ul class="foot__links">
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
          <li class="soon__tag">Riptide Digital (soon)</li>
        </ul>
      </div>
    </footer>

    <style is:global>
      /* ---------- Tokens ---------- */
      .pv-b {
        /* Colour (contrast against --base in brackets) */
        --base: #0d0c0a; /* near-black, slightly warm, like ink */
        --line: #2a2722; /* hairlines, decorative */
        --ink: #f4f0e6; /* headings, primary text (17.2:1) */
        --soft: #d0c9bb; /* body text (11.9:1) */
        --muted: #9c9587; /* dates, meta, small text (6.6:1) */
        --accent: #8df76a; /* the one green (14.6:1) */
        --on-accent: #0c1a06; /* text on green (13.4:1) */

        /* Type: a book face for reading, a plain sans for labels */
        --font-serif: 'Literata Variable', Georgia, serif;
        --font-sans: 'Hanken Grotesk Variable', system-ui, sans-serif;
        --t-meta: 0.875rem; /* 14px */
        --t-body: 1.125rem; /* 18px */
        --t-lede: clamp(1.3125rem, 1.2vw + 1rem, 1.625rem);
        --t-h3: clamp(1.5rem, 1.6vw + 1.1rem, 2rem);
        --t-display: clamp(2.75rem, 9.5vw, 6rem);

        /* Spacing: 8px base, widening quickly so sections breathe */
        --s1: 0.5rem;
        --s2: 1rem;
        --s3: 1.5rem;
        --s4: 2.5rem;
        --s5: 4rem;
        --s6: 6.5rem;
        --s7: 10.5rem;

        --ease: cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* ---------- Base ---------- */
      html {
        background: #0d0c0a;
        color-scheme: dark;
        scroll-behavior: smooth;
        scrollbar-color: #2a2722 #0d0c0a;
      }
      .pv-b {
        margin: 0;
        background: var(--base);
        color: var(--soft);
        font-family: var(--font-serif);
        font-size: var(--t-body);
        line-height: 1.65;
        font-optical-sizing: auto;
        font-synthesis: none;
        -webkit-font-smoothing: antialiased;
      }
      .pv-b *,
      .pv-b *::before,
      .pv-b *::after {
        box-sizing: border-box;
      }
      .pv-b h1,
      .pv-b h2,
      .pv-b h3,
      .pv-b p,
      .pv-b ul {
        margin: 0;
        padding: 0;
      }
      .pv-b ul {
        list-style: none;
      }
      .pv-b a {
        color: inherit;
        text-decoration: none;
      }
      .pv-b img {
        display: block;
        max-width: 100%;
        height: auto;
      }
      .pv-b ::selection {
        background: var(--accent);
        color: var(--on-accent);
      }
      .pv-b :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }
      .pv-b time {
        font-variant-numeric: tabular-nums;
      }
      .pv-b .wrap {
        --pad: clamp(1.25rem, 5vw, 3rem);
        max-width: 68rem;
        margin-inline: auto;
        padding-inline: var(--pad);
      }
      /* Hairline above each section, kept in line with the text edges */
      .pv-b .block,
      .pv-b .foot {
        position: relative;
      }
      .pv-b .block::before,
      .pv-b .foot::before {
        content: "";
        position: absolute;
        top: 0;
        left: var(--pad);
        right: var(--pad);
        height: 1px;
        background: var(--line);
      }
      .pv-b .skip {
        position: absolute;
        left: -999px;
        top: 0;
        z-index: 10;
        padding: var(--s1) var(--s2);
        background: var(--accent);
        color: var(--on-accent);
        font-family: var(--font-sans);
        font-weight: 600;
      }
      .pv-b .skip:focus {
        left: 0;
      }

      /* Everything that is a label rather than reading text uses the sans */
      .pv-b .pv-note,
      .pv-b .top,
      .pv-b .side,
      .pv-b .status,
      .pv-b .soon__tag,
      .pv-b .foot__links {
        font-family: var(--font-sans);
        font-size: var(--t-meta);
        line-height: 1.5;
      }
      .pv-b .pv-note {
        padding: var(--s1) var(--s2);
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        text-align: center;
      }
      .pv-b .pv-note a {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* Margin layout: labels in a left column, reading text beside them */
      .pv-b .row {
        display: grid;
        gap: var(--s2) var(--s4);
      }
      .pv-b .side {
        color: var(--muted);
        font-weight: 500;
      }

      /* The one link style: ink text, green underline that grows on hover */
      .pv-b .link,
      .pv-b .stack h3 a {
        color: var(--ink);
        background: linear-gradient(var(--accent), var(--accent)) no-repeat 0
          100% / 100% 1px;
        padding-bottom: 0.15em;
        transition: background-size 0.3s var(--ease);
      }
      .pv-b .stack h3 a {
        background-size: 0 1px;
      }
      .pv-b .link:hover {
        background-size: 100% 2px;
      }
      .pv-b .stack h3 a:hover {
        background-size: 100% 1px;
      }

      /* ---------- Header ---------- */
      .pv-b .top {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--s1) var(--s4);
        padding-block: var(--s3);
      }
      .pv-b .top__name {
        color: var(--ink);
        font-family: var(--font-serif);
        font-size: var(--t-body);
        font-weight: 500;
      }
      .pv-b .top__nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s1) var(--s3);
      }
      .pv-b .top__nav a {
        display: block;
        padding-block: var(--s1);
        color: var(--muted);
        transition: color 0.2s;
      }
      .pv-b .top__nav a:hover,
      .pv-b .top__nav a[aria-current='page'] {
        color: var(--ink);
      }

      /* ---------- Hero ---------- */
      .pv-b .hero {
        padding-block: clamp(4rem, 14vh, 9rem) var(--s6);
      }
      .pv-b h1 {
        color: var(--ink);
        font-size: var(--t-display);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.025em;
        text-wrap: balance;
      }
      .pv-b .apos {
        color: var(--accent);
      }
      .pv-b .hero .row {
        margin-top: var(--s5);
      }
      .pv-b .hero__now-label {
        display: block;
        color: var(--ink);
      }
      .pv-b .hero__lede {
        max-width: 36ch;
        color: var(--ink);
        font-size: var(--t-lede);
        line-height: 1.5;
      }
      .pv-b .hero__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--s2) var(--s4);
        margin-top: var(--s4);
      }
      .pv-b .soon {
        color: var(--ink);
      }
      .pv-b .soon__tag {
        margin-left: var(--s1);
        color: var(--muted);
      }

      /* ---------- Sections ---------- */
      .pv-b .block {
        padding-block: var(--s5);
      }
      .pv-b h2 {
        /* A real heading, set small in the margin */
        letter-spacing: 0;
      }
      .pv-b .stack {
        display: grid;
        gap: var(--s4);
      }
      .pv-b .stack li {
        max-width: 38rem;
      }
      .pv-b h3 {
        color: var(--ink);
        font-size: var(--t-h3);
        font-weight: 450;
        line-height: 1.2;
        letter-spacing: -0.015em;
        text-wrap: balance;
      }
      .pv-b .status {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--s1) var(--s2);
        margin-block: var(--s1);
        color: var(--muted);
      }
      .pv-b .dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--accent);
      }
      .pv-b .more {
        display: inline-block;
        margin-top: var(--s4);
      }

      /* ---------- Books ---------- */
      .pv-b .books__text {
        max-width: 38rem;
      }
      .pv-b .shelf {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 12rem));
        gap: var(--s3);
        margin-top: var(--s4);
      }
      .pv-b .shelf img,
      .pv-b .shelf .ph {
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 2px;
        box-shadow: 0 22px 36px -18px rgba(0, 0, 0, 0.95);
        transition: transform 0.5s var(--ease);
      }
      .pv-b .shelf a:hover img,
      .pv-b .shelf a:hover .ph {
        transform: translateY(-6px);
      }
      .pv-b .shelf__title {
        display: block;
        margin-top: var(--s2);
        color: var(--ink);
        font-style: italic;
      }
      .pv-b .shelf .status {
        margin: 0;
      }

      /* ---------- Footer ---------- */
      .pv-b .foot {
        margin-top: var(--s5);
        padding-block: var(--s5) var(--s6);
      }
      .pv-b .foot__name {
        color: var(--ink);
        font-size: var(--t-h3);
        line-height: 1.2;
      }
      .pv-b .foot__links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0 var(--s3);
        margin-top: var(--s2);
      }
      .pv-b .foot__links a {
        display: block;
        padding-block: var(--s1);
        color: var(--soft);
        transition: color 0.2s;
      }
      .pv-b .foot__links a:hover {
        color: var(--accent);
      }

      /* ---------- Wider screens ---------- */
      @media (min-width: 56rem) {
        .pv-b .row {
          grid-template-columns: 11rem minmax(0, 1fr);
          align-items: baseline;
        }
        /* Line the margin labels up with the first line of reading text */
        .pv-b .block > .side {
          padding-top: 0.6rem;
        }
      }

      /*
        Motion: no background effect. One quiet moment as the page opens (the
        name and intro settle into place), then nothing moves unless you
        hover. Skipped entirely under reduced motion.
      */
      @media (prefers-reduced-motion: no-preference) {
        .pv-b h1,
        .pv-b .hero .row {
          animation: pv-b-settle 1s var(--ease) both;
        }
        .pv-b .hero .row {
          animation-delay: 0.15s;
        }
        @keyframes pv-b-settle {
          from {
            opacity: 0;
            transform: translateY(14px);
            filter: blur(6px);
          }
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .pv-b * {
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
